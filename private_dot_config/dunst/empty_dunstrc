[global]
    frame_color = "#cba6f7"
    separator_color= frame
    highlight = "#89b4fa"
    horizontal_padding = 10
    padding = 8
    transparency = 15

[urgency_low]
    timeout = 4
    background = "#1e1e2e"
    foreground = "#cdd6f4"

[urgency_normal]
    timeout = 7
    background = "#1e1e2e"
    foreground = "#cdd6f4"

[urgency_critical]
    timeout = 0
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#fab387"
